#!/usr/bin/env bash
set -euo pipefail

echo "Running unit tests..."
go test ./...

if [[ -n "${TEST_DATABASE_URL:-}" ]]; then
  test_host="$(printf '%s' "$TEST_DATABASE_URL" | sed -E 's|^[a-zA-Z0-9+.-]+://([^/@]+@)?([^:/?]+).*|\2|')"
  case "$test_host" in
    localhost|127.0.0.1|::1|postgres|dragonki_postgres|*.local|*.internal)
      ;;
    *)
      echo "Refusing to run Postgres integration tests against non-local TEST_DATABASE_URL host: $test_host"
      exit 1
      ;;
  esac
  echo "Running Postgres integration tests..."
  go test ./internal/adapters/postgres -run Integration -count=1
else
  echo "Skipping Postgres integration tests: TEST_DATABASE_URL is not set."
fi
