# Base defaults applied to all environments
APP_ENV=development
RUN_MIGRATIONS=false
RUN_AUTO_MIGRATE=true
MIGRATIONS_DIR=db/migrations

# Core
BOT_TOKEN=
DATABASE_URL=
ENERGY_REGEN_TIME=10m
LEVEL_MULT=1

# Payments
MP_ACCESS_TOKEN=
MP_NOTIFICATION_URL=
MP_WEBHOOK_TOKEN=
KI_CRYSTALS_VALUE=1
KI_CRYSTALS_MULT=1
KI_CRYSTALS_CONVERT=100

# Queue (Big Boss rewards)
REDIS_URL=redis://localhost:6379
BIG_BOSS_QUEUE_ENABLED=false
BIG_BOSS_QUEUE_NAME=big_boss_rewards
QUEUE_CONCURRENCY=10
